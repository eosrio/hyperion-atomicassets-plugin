{
  "name": "@eosrio/hyperion-atomicassets-plugin",
  "version": "0.0.0-dev.1",
  "private": true,
  "type": "module",
  "description": "Development parity harness and query components for the planned AtomicAssets and AtomicMarket plugin",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "harness/shared/LICENSE.atomicassets-api.txt",
    "harness/shared/NOTICE.atomicassets-api.txt",
    "docs/parity/atomicmarket/UPSTREAM-LICENSE"
  ],
  "exports": {
    "./atomicmarket/sale": {
      "types": "./dist/atomicmarket/sale.d.ts",
      "import": "./dist/atomicmarket/sale.js"
    },
    "./atomicmarket/marketplace": {
      "types": "./dist/atomicmarket/marketplace.d.ts",
      "import": "./dist/atomicmarket/marketplace.js"
    },
    "./atomicassets/asset": {
      "types": "./dist/atomicassets/asset.d.ts",
      "import": "./dist/atomicassets/asset.js"
    },
    "./atomicmarket/marketplace-indexing": {
      "types": "./dist/atomicmarket/marketplace-indexing.d.ts",
      "import": "./dist/atomicmarket/marketplace-indexing.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:reference": "node --test tests/reference-asset.test.mjs tests/original-asset-controls.test.mjs tests/original-marketplace-controls.test.mjs tests/sale-formatter.test.mjs fixtures/harness/atomicmarket/reference-http.test.mjs",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "check:docs": "python scripts/check-docs.py",
    "reference:prepare": "node scripts/prepare-reference.mjs",
    "test:contextual": "node --test harness/atomicmarket/contextual.test.mjs harness/atomicmarket/host-artifacts.test.mjs"
  },
  "dependencies": {
    "@eosrio/hyperion-sdk": "git+https://github.com/eosrio/hyperion-sdk.git#8d37e932df5e0e7d671c9682505de3dd55f0edb4"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "github:eosrio/hyperion-sdk#8d37e932df5e0e7d671c9682505de3dd55f0edb4": true
  }
}
